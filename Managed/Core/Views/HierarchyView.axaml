<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArisenEditor.ViewModels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
             x:Class="ArisenEditor.Views.HierarchyView"
             x:DataType="vm:HierarchyViewModel">

    <Grid RowDefinitions="32,*">
        <!-- Toolbar -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource ArisenBorderDarkBrush}" BorderThickness="0,0,0,1" Padding="4,2">
            <Border Background="{DynamicResource ArisenSurfaceDarkBrush}"
                    CornerRadius="4"
                    BorderBrush="{DynamicResource ArisenBorderDarkBrush}"
                    BorderThickness="1"
                    Height="24">
                <Grid ColumnDefinitions="Auto,*">
                    <PathIcon Grid.Column="0" Data="{StaticResource SearchIcon}" Width="10" Height="10" Margin="6,0,4,0" Foreground="#64748b"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText}"
                             Watermark="Search entities..."
                             VerticalAlignment="Center"
                             Padding="0,0,6,0"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="11"/>
                </Grid>
            </Border>
        </Border>

        <!-- Hierarchy Tree -->
        <TreeView Grid.Row="1" 
                  x:Name="MainTreeView"
                  ItemsSource="{Binding RootNodes}" 
                  SelectedItem="{Binding SelectedItem}"
                  Background="Transparent"
                  BorderThickness="0">
            <TreeView.DataTemplates>
                <TreeDataTemplate DataType="vm:SceneNodeViewModel" ItemsSource="{Binding Entities}">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2">
                        <PathIcon Data="{StaticResource SceneIcon}" Width="14" Height="14" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </TreeDataTemplate>
                
                <TreeDataTemplate DataType="vm:SceneAssetEntityNodeViewModel" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2">
                        <PathIcon Data="{StaticResource EntityIcon}" Width="14" Height="14" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ComponentSummary}"
                                   VerticalAlignment="Center"
                                   Foreground="#64748b"
                                   FontSize="11"/>
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.DataTemplates>
            <TreeView.Styles>
                <Style Selector="TreeViewItem[DataContext={x:Type vm:SceneNodeViewModel}]" x:DataType="vm:SceneNodeViewModel">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}"/>
                </Style>
                <Style Selector="TreeViewItem[DataContext={x:Type vm:SceneAssetEntityNodeViewModel}]" x:DataType="vm:SceneAssetEntityNodeViewModel">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}"/>
                </Style>
            </TreeView.Styles>
        </TreeView>
    </Grid>

</UserControl>
